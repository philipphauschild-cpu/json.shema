{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zap Payload v5",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source": { "type": "string", "enum": ["internal"] },
    "summary": { "type": "string", "minLength": 1 },
    "salesforce_data": { "type": "string", "minLength": 1 },
    "notion_data": { "type": "string", "minLength": 1 },
    "founders": { "type": "string", "minLength": 1 },
    "news_and_funding": { "type": "string", "minLength": 1 },
    "website": { "type": "string", "format": "uri" },
    "file_url": { "type": "string", "format": "uri" }
  },
  "required": [
    "source",
    "summary",
    "salesforce_data",
    "notion_data",
    "founders",
    "news_and_funding",
    "website",
    "file_url"
  ]
}
